{
  "name": "satlas-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "wasm": "wasm-pack build ../crates/satlas-wasm --target web --out-dir ../../web/src/wasm/pkg --release",
    "wasm:dev": "wasm-pack build ../crates/satlas-wasm --target web --out-dir ../../web/src/wasm/pkg --dev"
  },
  "dependencies": {
    "@tanstack/react-query": "^5",
    "idb-keyval": "^6",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^4",
    "zustand": "^5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/node": "^26.6.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7",
    "vitest": "^3"
  }
}
